{
  "name": "mobora",
  "version": "1.0.0",
  "description": "Mobora — Phone Store OS (Electron POS & ERP)",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test:db": "electron test_db.js",
    "test:ipc": "electron test_ipc.js",
    "test:e2e": "electron test_e2e.js",
    "test:telegram": "electron test_telegram.js",
    "test:phase5": "electron test_phase5.js",
